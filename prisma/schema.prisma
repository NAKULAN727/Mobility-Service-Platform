datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum VehicleType {
  SEDAN
  SUV
  LUXURY
  VAN
  HATCHBACK
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum ServiceType {
  DRIVER_ONLY
  CAR_WITH_DRIVER
}

enum DriverType {
  DRIVER_ONLY
  DRIVER_WITH_VEHICLE
}

enum BookingStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  PENDING_DRIVER_ACCEPTANCE
  ACCEPTED
  DRIVER_ARRIVING
  OTP_PENDING
  OTP_VERIFIED
  TRIP_STARTED
  TRIP_COMPLETED
  REVIEW_PENDING
  CLOSED
  CANCELLED
  DISPUTED
  REJECTED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  DRIVING_LICENSE
  AADHAAR
  PAN_CARD
  VEHICLE_CERTIFICATE
}

// --- MODELS ---

model Vehicle {
  id                 String             @id @default(uuid())
  registrationNumber String             @unique
  make               String             @default("Unknown")
  model              String
  vehicleType        VehicleType
  seatingCapacity    Int
  insurance          String?
  verificationStatus VerificationStatus @default(PENDING)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  bookings           Booking[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([availabilityStatus, vehicleType])
}

model Location {
  id                  String   @id @default(uuid())
  pickupLocation      String
  destinationLocation String
  distance            Float    // in kilometers
  estimatedDuration   Int      // in minutes
  booking             Booking?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Booking {
  id              String        @id @default(uuid())
  customerId      String
  driverId        String?
  vehicleId       String?
  serviceType     ServiceType
  locationId      String        @unique
  bookingDate     DateTime      @db.Date
  bookingTime     String        // Time of day format: "HH:MM:SS" or "HH:MM"
  fareAmount      Decimal       @db.Decimal(10, 2)
  bookingStatus   BookingStatus @default(REQUESTED)
  otpCode         String        @default("000000")
  actualStartTime DateTime?
  actualEndTime   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  payment  Payment?
  review   Review?

  @@index([customerId])
  @@index([driverId])
  @@index([bookingStatus])
  @@index([bookingDate])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([paymentStatus])
}

model User {
  id           String         @id @default(uuid())
  fullName     String
  email        String         @unique
  phone        String
  password     String
  role         Role
  profileImage String?
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  driverProfile DriverProfile?
}

model DriverProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  licenseNumber      String
  experienceYears    Int
  driverType         DriverType         @default(DRIVER_ONLY)
  ownsVehicle        Boolean            @default(false)
  vehicleId          String?
  availabilityStatus Boolean            @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          DriverDocument[]
}

model DriverDocument {
  id            String         @id @default(uuid())
  driverId      String
  documentType  DocumentType
  documentUrl   String
  uploadedAt    DateTime       @default(now())
  driverProfile DriverProfile  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, documentType]) // Ensure one upload of each type per driver
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  rating     Int
  reviewText String
  sentiment  String
  confidence Float
  keywords   String[]
  summary    String
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([createdAt])
}

