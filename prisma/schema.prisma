datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  DRIVING_LICENSE
  AADHAAR
  PAN_CARD
  VEHICLE_CERTIFICATE
}

model User {
  id           String         @id @default(uuid())
  fullName     String
  email        String         @unique
  phone        String
  password     String
  role         Role
  profileImage String?
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  driverProfile DriverProfile?
}

model DriverProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  licenseNumber      String
  experienceYears    Int
  availabilityStatus Boolean            @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          DriverDocument[]
}

model DriverDocument {
  id            String         @id @default(uuid())
  driverId      String
  documentType  DocumentType
  documentUrl   String
  uploadedAt    DateTime       @default(now())
  driverProfile DriverProfile  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, documentType]) // Ensure one upload of each type per driver
}
